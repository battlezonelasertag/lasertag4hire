# Resend API key — get yours at resend.com/api-keys
RESEND_API_KEY=re_your_key_here

# Email address that receives enquiry form submissions
CONTACT_EMAIL=info@lasertag4hire.com.au

# PostHog (visitor analytics). Project token from PostHog → Project settings. Only loads on the
# Vercel production deployment. Region is "us" or "eu" (whichever your PostHog account is in).
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_token
NEXT_PUBLIC_POSTHOG_REGION=us
# Optional: the number in your PostHog URL (/project/12345), for links in Mailchimp notes
POSTHOG_PROJECT_ID=

# Mailchimp (enquirers become contacts). API key from Profile → Extras → API keys (ends in -usXX).
# Audience ID from Audience → Settings → Audience name and defaults.
# Then run once: node --env-file=.env.local scripts/mailchimp-setup.mjs
MAILCHIMP_API_KEY=your_key-us21
MAILCHIMP_AUDIENCE_ID=
